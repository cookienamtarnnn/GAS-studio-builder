{
  "name": "gas-studio-builder-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "rm -rf dist && mkdir -p dist && cp appsscript.json dist/ && cp -R src/server/* dist/",
    "build:preview": "vite preview",
    "push": "npm run build && clasp push",
    "lint": "oxlint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@google/clasp": "^3.4.1",
    "@google/generative-ai": "^0.24.1",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.108.4",
    "autoprefixer": "^10.7.0",
    "axios": "^1.21.1",
    "concurrently": "^10.0.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "openai": "^7.63.0",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.0.0"
  }
}